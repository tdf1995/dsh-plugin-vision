{
  "name": "dsh-plugin-vision",
  "version": "0.2.0",
  "description": "DeepSeek Harness native plugin: give text-only LLMs (e.g. DeepSeek) vision via free Gemini / GLM vision APIs — describe images, OCR, VQA, screenshots, charts; integrated browser paste & drop.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node scripts/load-test.mjs && node --check lib/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "vision",
    "image-analysis",
    "ocr",
    "gemini",
    "glm",
    "zhipu",
    "multimodal",
    "plugin",
    "webui"
  ],
  "license": "MIT",
  "author": "dsh-plugin-vision contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdf1995/dsh-plugin-vision.git"
  },
  "bugs": {
    "url": "https://github.com/tdf1995/dsh-plugin-vision/issues"
  },
  "homepage": "https://github.com/tdf1995/dsh-plugin-vision#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
